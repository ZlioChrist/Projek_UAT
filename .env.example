APP_NAME=WadahNgopi
APP_ENV=local # Set to 'production' on your actual server
APP_KEY=
APP_DEBUG=true # MUST be false in production
APP_URL=http://wadahngopi.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug # Set to 'warning' in production to optimize performance

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wadahngopi
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database # Change to 'redis' if available (Critical for performance)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE=false # MUST BE 'true' AS SOON AS YOU USE HTTPS (Production)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_STORE=database # Change to 'redis' for optimal performance (Production)

# Broadcast & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database # Use 'redis' or 'database' in production

# Redis Configuration (Required if using redis driver)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wadahngopi.com"
MAIL_FROM_NAME="${APP_NAME}"

# VITE
VITE_APP_NAME="${APP_NAME}"

# Google OAuth (never commit real credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_MAPS_GEOCODING_API_KEY=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_CHAT_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Meta WhatsApp Cloud API (Phone Number ID is the numeric ID from Meta, not the phone number)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Set the name of an approved Meta Authentication template with an OTP URL button.
META_WHATSAPP_OTP_TEMPLATE=
META_WHATSAPP_GRAPH_VERSION=v23.0

# Optional CA bundle path for Windows PHP installations without a default trust store
WADAHNGOPI_CA_BUNDLE=
CRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
