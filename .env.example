APP_NAME=WadahNgopi
APP_ENV=local # Set to 'production' on your actual server
APP_KEY=
APP_DEBUG=true # MUST be false in production
APP_URL=http://wadahngopi.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug # Set to 'warning' in production to optimize performance

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wadahngopi
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database # Change to 'redis' if available (Critical for performance)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE=false # MUST BE 'true' AS SOON AS YOU USE HTTPS (Production)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_STORE=database # Change to 'redis' for optimal performance (Production)

# Broadcast & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database # Use 'redis' or 'database' in production

# Redis Configuration (Required if using redis driver)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wadahngopi.com"
MAIL_FROM_NAME="${APP_NAME}"

# VITE
VITE_APP_NAME="${APP_NAME}"

# Optional CA bundle path for Windows PHP installations without a default trust store
WADAHNGOPI_CA_BUNDLE=
CRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
